#include <winver.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/crumbwriter.ico"
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/crumbwriter.manifest"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@CRUMB_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@CRUMB_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Crumb Writer"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "crumbwriter"
      VALUE "LegalCopyright", "Original Crumb Writer code released under the Unlicense"
      VALUE "OriginalFilename", "crumbwriter.exe"
      VALUE "ProductName", "Crumb Writer"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
